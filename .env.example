# --- Site ---
NEXT_PUBLIC_SITE_URL="https://sipsocial.co.uk"

# --- Enquiry email (Resend) ---
# Create a key at resend.com and verify the sending domain.
RESEND_API_KEY=""
ENQUIRY_TO_EMAIL="sipsocialuk@outlook.com"
ENQUIRY_FROM_EMAIL="enquiries@sipsocial.co.uk"

# --- Spam protection (Cloudflare Turnstile, free) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Instagram feed (optional; gallery falls back to curated images) ---
# Long-lived token from the Instagram Basic Display / Graph API.
INSTAGRAM_ACCESS_TOKEN=""

# --- Tina CMS (required for /admin on the live site; not needed for local dev) ---
# Create a free project at tina.io connected to this GitHub repo to get these.
NEXT_PUBLIC_TINA_CLIENT_ID=""
TINA_TOKEN=""
